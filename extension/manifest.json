{
  "manifest_version": 2,
  "name": "Web Job Scraper",
  "version": "0.10.1",
  "description": "Saves the jobs you browse on LinkedIn and the Maryland Workforce Exchange into daily files that Job Finder imports.",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-job-scraper@jamie.local",
      "strict_min_version": "115.0",
      "update_url": "https://jltkerig.github.io/web-job-scraper/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "https://www.linkedin.com/*",
    "https://mwejobs.maryland.gov/*",
    "https://www.mwejobs.maryland.gov/*",
    "https://jltkerig.github.io/web-job-scraper/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "scripts": ["sites/linkedin-parse.js", "sites/mwe-parse.js", "sites/usajobs-parse.js", "sites/sample-only.js", "background.js", "runs.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["sites/linkedin-parse.js", "content/capture.js", "pet/sprites.js", "pet/pet.js", "content/pet-strip.js",
             "sites/linkedin-fit.js", "content/fit-marks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.indeed.com/*", "https://indeed.com/*"],
      "js": ["sites/sample-only.js", "content/capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.usajobs.gov/*", "https://usajobs.gov/*"],
      "js": ["sites/usajobs-parse.js", "content/capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mwejobs.maryland.gov/*", "https://www.mwejobs.maryland.gov/*"],
      "js": ["sites/mwe-parse.js", "content/capture.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Web Job Scraper",
    "default_popup": "popup/popup.html"
  }
}
